<?xml version="1.0" encoding="UTF-8"?>
<!--
  DRAFT FOR CCB DISCUSSION - validates against the draft PIXM_GRF_Proposal.xsd only.
  Purpose:   A GRF runway condition report for runway 28 sent on its own as a notification:
             RWYCC 5/5/3, wet snow 3 mm on the first two thirds, compacted snow on the
             last third, cleared width 40 m, a snowbank on the left.
  Scenario:  GRF proposal prototype (docs/proposals/grf/README.md).
  PIXM:      0.5 + GRF draft
  Exercises: GRFRunwayConditionNotification, GRFRunwayConditionReport, RunwayContamination,
             Ridge, RunwaySectionContamination.
  Data:      Illustrative only, not a real aerodrome (LXXX). Conditions and identifiers
             are fictional. Not for operational use.
-->
<pixm:GRFRunwayConditionNotification xmlns:pixm="http://www.pixm.aero/schema/0.5"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.pixm.aero/schema/0.5 ../PIXM_GRF_Proposal.xsd"
    gml:id="grf_28">
    <pixm:timeSlice>
        <pixm:GRFRunwayConditionNotificationTimeSlice gml:id="grf_28_ts1">
            <gml:validTime>
                <gml:TimePeriod gml:id="grf__28_tp1">
                    <gml:beginPosition>2026-12-15T05:40:00Z</gml:beginPosition>
                    <gml:endPosition indeterminatePosition="unknown"/>
                </gml:TimePeriod>
            </gml:validTime>
            <pixm:interpretation>BASELINE</pixm:interpretation>
            <pixm:messageId>0d6f1b2e-8c4a-4e3b-9f21-5a7c3e9d4b10</pixm:messageId>
            <pixm:sourceId>3f2a1b4c-5d6e-4f70-8a9b-0c1d2e3f4a5b</pixm:sourceId>
            <pixm:grfRunwayConditionReport>
                <pixm:aerodromeDesignator>LXXX</pixm:aerodromeDesignator>
                <pixm:runwayDirectionDesignator>28</pixm:runwayDirectionDesignator>
                <pixm:observationTime>2026-12-15T05:40:00Z</pixm:observationTime>
                <pixm:rcamVersionReference>DOC9981-2020</pixm:rcamVersionReference>

                <!-- Whole runway contamination example-->
                <pixm:runwayContamination>
                    <pixm:clearedWidth uom="M">40</pixm:clearedWidth>
                    <pixm:criticalRidge>
                        <pixm:side>LEFT</pixm:side>
                        <pixm:distanceFromCenterline uom="M">22</pixm:distanceFromCenterline>
                        <pixm:height uom="CM">40</pixm:height>
                    </pixm:criticalRidge>
                    <pixm:nextObservationTime>2026-12-15T07:00:00Z</pixm:nextObservationTime>
                </pixm:runwayContamination>

                <!-- Runway 1/3s contamination example-->
                <pixm:sectionContamination>
                    <pixm:section>FIRST</pixm:section>
                    <pixm:runwayConditionCode>5</pixm:runwayConditionCode>
                    <pixm:contaminant>WET_SNOW</pixm:contaminant>
                    <pixm:depth uom="MM">3</pixm:depth>
                    <pixm:proportion>50</pixm:proportion>
                </pixm:sectionContamination>
                <pixm:sectionContamination>
                    <pixm:section>SECOND</pixm:section>
                    <pixm:runwayConditionCode>5</pixm:runwayConditionCode>
                    <pixm:contaminant>WET_SNOW</pixm:contaminant>
                    <pixm:depth uom="MM">3</pixm:depth>
                    <pixm:proportion>50</pixm:proportion>
                </pixm:sectionContamination>
                <pixm:sectionContamination>
                    <pixm:section>THIRD</pixm:section>
                    <pixm:runwayConditionCode>3</pixm:runwayConditionCode>
                    <pixm:contaminant>COMPACTED_SNOW</pixm:contaminant>
                    <pixm:proportion>100</pixm:proportion>
                </pixm:sectionContamination>
                
            </pixm:grfRunwayConditionReport>
        </pixm:GRFRunwayConditionNotificationTimeSlice>
    </pixm:timeSlice>
</pixm:GRFRunwayConditionNotification>
