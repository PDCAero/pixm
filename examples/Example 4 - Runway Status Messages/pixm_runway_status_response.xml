<?xml version="1.0" encoding="UTF-8"?>
<!--
  Purpose:   Response to a simple runway status request: all six runway ends open now
             (BASELINE), and the next expected change, a temporary closure of runway
             ends 16 and 34 (TEMPDELTA).
  Scenario:  Example 4 - Runway Status Messages.
  PIXM:      0.5
  Exercises: SimpleRunwayStatusResponse, SimpleRunwayEndStatus.
  Data:      Illustrative only, based on a real aerodrome (LSZH). Identifiers and the
             closure are fictional. Not for operational use.
-->
<pixm:SimpleRunwayStatusResponse xmlns:pixm="http://www.pixm.aero/schema/0.5"
                                 xmlns:gml="http://www.opengis.net/gml/3.2"
                                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                                 xsi:schemaLocation="http://www.pixm.aero/schema/0.5 ../../schema/0.5/PIXM_Messages.xsd"
                                 gml:id="rs_resp_1">
    <pixm:timeSlice>
        <pixm:SimpleRunwayStatusResponseTimeSlice gml:id="rs_resp_ts_1">
            <gml:validTime>
                <gml:TimePeriod gml:id="tp_current">
                    <gml:beginPosition>2026-05-01T00:00:00Z</gml:beginPosition>
                    <gml:endPosition indeterminatePosition="unknown"/>
                </gml:TimePeriod>
            </gml:validTime>
            <pixm:interpretation>BASELINE</pixm:interpretation>

            <!-- Response metadata -->
            <pixm:providerId>5f0c2a8e-3d1b-4c7a-9e2f-6a4b8c0d1e23</pixm:providerId>
            <pixm:requestId>b802d439-e9f3-49f9-96e1-0153b837e113</pixm:requestId>
            <pixm:responseId>b802d439-e9f3-49f9-96e1-0153b837eabc</pixm:responseId>
            <pixm:responseTimestamp>2026-05-01T00:00:00Z</pixm:responseTimestamp>
            <pixm:success>YES</pixm:success>

            <!-- Response content -->
            <pixm:aerodromeDesignator>LSZH</pixm:aerodromeDesignator>

            <pixm:runwayEndStatus>
                <pixm:openLanding>YES</pixm:openLanding>
                <pixm:openTakeoff>YES</pixm:openTakeoff>
                <pixm:runwayDirectionDesignator>16</pixm:runwayDirectionDesignator>
            </pixm:runwayEndStatus>
            <pixm:runwayEndStatus>
                <pixm:openLanding>YES</pixm:openLanding>
                <pixm:openTakeoff>YES</pixm:openTakeoff>
                <pixm:runwayDirectionDesignator>34</pixm:runwayDirectionDesignator>
            </pixm:runwayEndStatus>
            <pixm:runwayEndStatus>
                <pixm:openLanding>YES</pixm:openLanding>
                <pixm:openTakeoff>YES</pixm:openTakeoff>
                <pixm:runwayDirectionDesignator>14</pixm:runwayDirectionDesignator>
            </pixm:runwayEndStatus>
            <pixm:runwayEndStatus>
                <pixm:openLanding>YES</pixm:openLanding>
                <pixm:openTakeoff>YES</pixm:openTakeoff>
                <pixm:runwayDirectionDesignator>32</pixm:runwayDirectionDesignator>
            </pixm:runwayEndStatus>
            <pixm:runwayEndStatus>
                <pixm:openLanding>YES</pixm:openLanding>
                <pixm:openTakeoff>YES</pixm:openTakeoff>
                <pixm:runwayDirectionDesignator>10</pixm:runwayDirectionDesignator>
            </pixm:runwayEndStatus>
            <pixm:runwayEndStatus>
                <pixm:openLanding>YES</pixm:openLanding>
                <pixm:openTakeoff>YES</pixm:openTakeoff>
                <pixm:runwayDirectionDesignator>28</pixm:runwayDirectionDesignator>
            </pixm:runwayEndStatus>
        </pixm:SimpleRunwayStatusResponseTimeSlice>
    </pixm:timeSlice>

    <pixm:timeSlice>
        <pixm:SimpleRunwayStatusResponseTimeSlice gml:id="rs_resp_ts_2">
            <gml:validTime>
                <gml:TimePeriod gml:id="tp_next">
                    <gml:beginPosition>2026-05-10T00:00:00Z</gml:beginPosition>
                    <gml:endPosition>2026-05-10T00:06:00Z</gml:endPosition>
                </gml:TimePeriod>
            </gml:validTime>
            <pixm:interpretation>TEMPDELTA</pixm:interpretation>

            <!-- Response metadata -->
            <pixm:providerId>5f0c2a8e-3d1b-4c7a-9e2f-6a4b8c0d1e23</pixm:providerId>
            <pixm:requestId>b802d439-e9f3-49f9-96e1-0153b837e113</pixm:requestId>
            <pixm:responseId>b802d439-e9f3-49f9-96e1-0153b837eabc</pixm:responseId>
            <pixm:responseTimestamp>2026-05-01T00:00:00Z</pixm:responseTimestamp>
            <pixm:success>YES</pixm:success>

            <!-- Response content: only the runway ends that change -->
            <pixm:aerodromeDesignator>LSZH</pixm:aerodromeDesignator>

            <pixm:runwayEndStatus>
                <pixm:openLanding>NO</pixm:openLanding>
                <pixm:openTakeoff>NO</pixm:openTakeoff>
                <pixm:runwayDirectionDesignator>16</pixm:runwayDirectionDesignator>
            </pixm:runwayEndStatus>
            <pixm:runwayEndStatus>
                <pixm:openLanding>NO</pixm:openLanding>
                <pixm:openTakeoff>NO</pixm:openTakeoff>
                <pixm:runwayDirectionDesignator>34</pixm:runwayDirectionDesignator>
            </pixm:runwayEndStatus>
        </pixm:SimpleRunwayStatusResponseTimeSlice>
    </pixm:timeSlice>
</pixm:SimpleRunwayStatusResponse>
