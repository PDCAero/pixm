<?xml version="1.0" encoding="UTF-8"?>
<!--
  Purpose:   A runway reference point sent on its own: the start of the takeoff run from
             intersection B9 on runway 10.
  Scenario:  Example 5 - Standalone Data Blocks (principle 4: a block is interpretable on its own).
  PIXM:      0.5
  Exercises: RunwayReferencePoint, ElevatedPoint.
  Data:      Illustrative only, taken from departure intersection B9 for runway 10 at a real
             aerodrome (LSZH) in Example 3. Elevation datum
             relabeled EGM_96; elevation illustrative. Not for operational use.
-->
<pixm:RunwayReferencePoint xmlns:pixm="http://www.pixm.aero/schema/0.5"
    xmlns:gml="http://www.opengis.net/gml/3.2"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.pixm.aero/schema/0.5 ../../schema/0.5/PIXM_Features.xsd">
    <pixm:designator>10_B9</pixm:designator>
    <pixm:role>START_RUN</pixm:role>
    <pixm:location>
        <pixm:point>
            <gml:Point gml:id="pt_10_B9" srsName="urn:ogc:def:crs:EPSG::4326">
                <gml:pos>47.45892498 8.537672986</gml:pos>
            </gml:Point>
        </pixm:point>
        <pixm:elevation uom="FT">1390.7</pixm:elevation>
        <pixm:verticalDatum>EGM_96</pixm:verticalDatum>
    </pixm:location>
</pixm:RunwayReferencePoint>
