					<xs:documentation>The maximum aircraft wingspan allowed. [PIXM]</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="bearingStrength" type="pixm:BearingStrengthType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>The bearing strength of the pavement. [ICAO Annex 14]</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>