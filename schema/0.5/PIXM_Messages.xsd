<?xml version='1.0' encoding='utf-8' ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
	xmlns:gml="http://www.opengis.net/gml/3.2"
	targetNamespace="http://www.pixm.aero/schema/0.5"
	xmlns="http://www.pixm.aero/schema/0.5"
	xmlns:pixm="http://www.pixm.aero/schema/0.5"
	elementFormDefault="qualified"
	version="0.5">

	<xs:import namespace="http://www.opengis.net/gml/3.2" schemaLocation="http://schemas.opengis.net/gml/3.2.1/gml.xsd"/>

	<!-- Include the main PIXM types to access base TimeSlice and Feature types -->
	<xs:include schemaLocation="PIXM_Features.xsd"/>

	<!-- ========================================================== -->
	<!-- Abstract Base Types for Requests, Responses, Notifications -->
	<!-- Feature vs object for these bases: open.md #12 (DEC-0004)  -->
	<!-- ========================================================== -->

	<!-- AbstractPIXMRequest -->
	<xs:element name="AbstractPIXMRequestTimeSlice" type="pixm:AbstractPIXMRequestTimeSliceType" abstract="true" substitutionGroup="pixm:AbstractPIXMTimeSlice"/>
	<xs:complexType name="AbstractPIXMRequestTimeSliceType" abstract="true">
		<xs:annotation>
			<xs:documentation>Abstract base for the time slices of PIXM requests, carrying the identification and timing common to all requests. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMTimeSliceType">
				<xs:sequence>
					<xs:element name="requesterId" type="pixm:UniversallyUniqueIdentifierType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>UUID identifying the requester (system or client) submitting the request. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="requestId" type="pixm:UniversallyUniqueIdentifierType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>UUID uniquely identifying this request instance, used to correlate the request with its response. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="requestTimestamp" type="pixm:DateTimeType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>UTC date and time at which the request was generated, as an ISO 8601 dateTime with at least second precision (e.g. 2026-05-01T13:45:00Z). [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="AbstractPIXMRequest" type="pixm:AbstractPIXMRequestType" abstract="true" substitutionGroup="pixm:AbstractPIXMFeature"/>
	<xs:complexType name="AbstractPIXMRequestType" abstract="true">
		<xs:annotation>
			<xs:documentation>Abstract base feature for PIXM requests: a request from a client to a service for information. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMFeatureType"/>
		</xs:complexContent>
	</xs:complexType>

	<!-- AbstractPIXMResponse -->
	<xs:element name="AbstractPIXMResponseTimeSlice" type="pixm:AbstractPIXMResponseTimeSliceType" abstract="true" substitutionGroup="pixm:AbstractPIXMTimeSlice"/>
	<xs:complexType name="AbstractPIXMResponseTimeSliceType" abstract="true">
		<xs:annotation>
			<xs:documentation>Abstract base for the time slices of PIXM responses, carrying the identification, outcome and request correlation common to all responses. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMTimeSliceType">
				<xs:sequence>
					<!-- Free text and xs:string kept as ported (DEC-0004). -->
					<xs:element name="errorMessage" type="xs:string" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Human-readable description of the error that prevented the request from being processed successfully. Free text, for diagnostics only. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="providerId" type="pixm:UniversallyUniqueIdentifierType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>UUID identifying the service provider that generated the response. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="requestId" type="pixm:UniversallyUniqueIdentifierType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>UUID of the request that this response answers, copied from the request for correlation. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="responseId" type="pixm:UniversallyUniqueIdentifierType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>UUID uniquely identifying this response instance. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="responseTimestamp" type="pixm:DateTimeType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>UTC date and time at which the response was generated, as an ISO 8601 dateTime (e.g. 2026-05-01T13:45:00Z). [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="success" type="pixm:CodeYesNoType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Whether the request was processed successfully (YES) or not (NO). [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="AbstractPIXMResponse" type="pixm:AbstractPIXMResponseType" abstract="true" substitutionGroup="pixm:AbstractPIXMFeature"/>
	<xs:complexType name="AbstractPIXMResponseType" abstract="true">
		<xs:annotation>
			<xs:documentation>Abstract base feature for PIXM responses: the answer of a service to a PIXM request. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMFeatureType"/>
		</xs:complexContent>
	</xs:complexType>

	<!-- AbstractPIXMNotification -->
	<xs:element name="AbstractPIXMNotificationTimeSlice" type="pixm:AbstractPIXMNotificationTimeSliceType" abstract="true" substitutionGroup="pixm:AbstractPIXMTimeSlice"/>
	<xs:complexType name="AbstractPIXMNotificationTimeSliceType" abstract="true">
		<xs:annotation>
			<xs:documentation>Abstract base for the time slices of PIXM notifications, carrying the identification and service status common to all notifications. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMTimeSliceType">
				<xs:sequence>
					<xs:element name="messageId" type="pixm:UniversallyUniqueIdentifierType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>UUID uniquely identifying this notification instance. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<!-- Integer code kept as ported (DEC-0004). -->
					<xs:element name="serviceStatusCode" type="xs:positiveInteger" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Numeric code giving the status of the originating service when the notification was generated. The code values are not defined by PIXM. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="sourceId" type="pixm:UniversallyUniqueIdentifierType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>UUID identifying the source system that produced the notification. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="AbstractPIXMNotification" type="pixm:AbstractPIXMNotificationType" abstract="true" substitutionGroup="pixm:AbstractPIXMFeature"/>
	<xs:complexType name="AbstractPIXMNotificationType" abstract="true">
		<xs:annotation>
			<xs:documentation>Abstract base feature for PIXM notifications: information pushed by a service without a prior request. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMFeatureType"/>
		</xs:complexContent>
	</xs:complexType>

	<!-- ========================================================== -->
	<!-- Simple Runway Status                                       -->
	<!-- ========================================================== -->

	<xs:element name="SimpleRunwayEndStatus" type="pixm:SimpleRunwayEndStatusType"/>
	<xs:complexType name="SimpleRunwayEndStatusType">
		<xs:annotation>
			<xs:documentation>The operational status of a single runway direction (runway end): whether it is open for landing and whether it is open for takeoff. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="openLanding" type="pixm:CodeYesNoType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Whether the runway direction is open for landing operations (YES) or closed to them (NO). [PIXM]</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="openTakeoff" type="pixm:CodeYesNoType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Whether the runway direction is open for takeoff operations (YES) or closed to them (NO). [PIXM]</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="runwayDirectionDesignator" type="pixm:TextDesignatorType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Designator of the runway direction to which the status applies, as published for the aerodrome (e.g. 28L, 09R). [AIXM 5.1.1]</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<!-- SimpleRunwayStatusRequest -->
	<xs:element name="SimpleRunwayStatusRequestTimeSlice" type="pixm:SimpleRunwayStatusRequestTimeSliceType" substitutionGroup="pixm:AbstractPIXMRequestTimeSlice"/>
	<xs:complexType name="SimpleRunwayStatusRequestTimeSliceType">
		<xs:annotation>
			<xs:documentation>A time slice of a request for the operational status of the runways at an aerodrome, optionally at a given time. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMRequestTimeSliceType">
				<xs:sequence>
					<xs:element name="aerodromeDesignator" type="pixm:CodeAirportHeliportDesignatorType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Designator of the aerodrome for which runway status is requested (e.g. the ICAO location indicator LSZH). [AIXM 5.1.1]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="provideNextExpectedChange" type="pixm:CodeYesNoType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Whether the response is to include the next expected change to runway status (YES) or not (NO). [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="timeInstant" type="pixm:DateTimeType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>UTC date and time for which runway status is requested. When absent, the current operational status is requested. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="SimpleRunwayStatusRequest" type="pixm:SimpleRunwayStatusRequestType" substitutionGroup="pixm:AbstractPIXMRequest"/>
	<xs:complexType name="SimpleRunwayStatusRequestType">
		<xs:annotation>
			<xs:documentation>A request for the operational status of the runways at an aerodrome. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMRequestType">
				<xs:sequence>
					<xs:element name="timeSlice" type="pixm:SimpleRunwayStatusRequestTimeSlicePropertyType" minOccurs="1" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>A time slice of the Simple Runway Status Request feature: its state during one period of validity. [AIXM 5.1.1]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SimpleRunwayStatusRequestTimeSlicePropertyType">
		<xs:annotation>
			<xs:documentation>A property that contains one Simple Runway Status Request time slice. [AIXM 5.1.1]</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="pixm:SimpleRunwayStatusRequestTimeSlice" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
		<xs:attributeGroup ref="gml:OwnershipAttributeGroup"/>
	</xs:complexType>

	<!-- SimpleRunwayStatusResponse -->
	<xs:element name="SimpleRunwayStatusResponseTimeSlice" type="pixm:SimpleRunwayStatusResponseTimeSliceType" substitutionGroup="pixm:AbstractPIXMResponseTimeSlice"/>
	<xs:complexType name="SimpleRunwayStatusResponseTimeSliceType">
		<xs:annotation>
			<xs:documentation>A time slice of a response giving the operational status of the runway directions at an aerodrome. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMResponseTimeSliceType">
				<xs:sequence>
					<xs:element name="aerodromeDesignator" type="pixm:CodeAirportHeliportDesignatorType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Designator of the aerodrome to which the runway status applies (e.g. the ICAO location indicator LSZH). [AIXM 5.1.1]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="runwayEndStatus" type="pixm:SimpleRunwayEndStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The operational status of one runway direction at the aerodrome; one entry per runway direction reported. Unordered. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="SimpleRunwayStatusResponse" type="pixm:SimpleRunwayStatusResponseType" substitutionGroup="pixm:AbstractPIXMResponse"/>
	<xs:complexType name="SimpleRunwayStatusResponseType">
		<xs:annotation>
			<xs:documentation>A response giving the operational status of the runways at an aerodrome, answering a Simple Runway Status Request. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMResponseType">
				<xs:sequence>
					<xs:element name="timeSlice" type="pixm:SimpleRunwayStatusResponseTimeSlicePropertyType" minOccurs="1" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>A time slice of the Simple Runway Status Response feature: its state during one period of validity. [AIXM 5.1.1]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SimpleRunwayStatusResponseTimeSlicePropertyType">
		<xs:annotation>
			<xs:documentation>A property that contains one Simple Runway Status Response time slice. [AIXM 5.1.1]</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="pixm:SimpleRunwayStatusResponseTimeSlice" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
		<xs:attributeGroup ref="gml:OwnershipAttributeGroup"/>
	</xs:complexType>

	<!-- SimpleRunwayStatusMessage -->
	<xs:element name="SimpleRunwayStatusMessageTimeSlice" type="pixm:SimpleRunwayStatusMessageTimeSliceType" substitutionGroup="pixm:AbstractPIXMNotificationTimeSlice"/>
	<xs:complexType name="SimpleRunwayStatusMessageTimeSliceType">
		<xs:annotation>
			<xs:documentation>A time slice of an unsolicited notification giving the operational status of the runway directions at an aerodrome. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMNotificationTimeSliceType">
				<xs:sequence>
					<xs:element name="aerodromeDesignator" type="pixm:CodeAirportHeliportDesignatorType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Designator of the aerodrome to which the runway status applies (e.g. the ICAO location indicator LSZH). [AIXM 5.1.1]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="runwayEndStatus" type="pixm:SimpleRunwayEndStatusType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>The operational status of one runway direction at the aerodrome; one entry per runway direction reported. Unordered. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="SimpleRunwayStatusMessage" type="pixm:SimpleRunwayStatusMessageType" substitutionGroup="pixm:AbstractPIXMNotification"/>
	<xs:complexType name="SimpleRunwayStatusMessageType">
		<xs:annotation>
			<xs:documentation>An unsolicited notification giving the operational status of the runways at an aerodrome. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMNotificationType">
				<xs:sequence>
					<xs:element name="timeSlice" type="pixm:SimpleRunwayStatusMessageTimeSlicePropertyType" minOccurs="1" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>A time slice of the Simple Runway Status Message feature: its state during one period of validity. [AIXM 5.1.1]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="SimpleRunwayStatusMessageTimeSlicePropertyType">
		<xs:annotation>
			<xs:documentation>A property that contains one Simple Runway Status Message time slice. [AIXM 5.1.1]</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="pixm:SimpleRunwayStatusMessageTimeSlice" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
		<xs:attributeGroup ref="gml:OwnershipAttributeGroup"/>
	</xs:complexType>

	<!-- ========================================================== -->
	<!-- Runway access point status (DEC-0005)                      -->
	<!-- ========================================================== -->

	<xs:element name="AbstractRunwayAccessPointStatusTimeSlice" type="pixm:AbstractRunwayAccessPointStatusTimeSliceType" abstract="true" substitutionGroup="pixm:AbstractPIXMNotificationTimeSlice"/>
	<xs:complexType name="AbstractRunwayAccessPointStatusTimeSliceType" abstract="true">
		<xs:annotation>
			<xs:documentation>Abstract base for the time slices of status notifications about a runway access point (a departure intersection or a landing exit): its identification, whether it is closed or active, and any temporary restriction. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMNotificationTimeSliceType">
				<xs:sequence>
					<xs:element name="aerodromeDesignator" type="pixm:CodeAirportHeliportDesignatorType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Designator of the aerodrome at which the runway access point is located (e.g. the ICAO location indicator LSZH). [AIXM 5.1.1]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="runwayDirectionDesignator" type="pixm:TextDesignatorType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Designator of the runway direction that the runway access point serves (e.g. 10, 28L). [AIXM 5.1.1]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="designator" type="pixm:TextDesignatorType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>The designator of the runway access point (departure intersection or landing exit) whose status is given (e.g. B9). [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="closed" type="pixm:CodeYesNoType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Whether the runway access point is physically closed (YES), for example for works, or open (NO). A closed point is never active. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="active" type="pixm:CodeYesNoType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Whether the runway access point is currently in use by air traffic control (YES) or not (NO). An open point may be inactive. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="restriction" type="pixm:UsageLimitationType" minOccurs="0" maxOccurs="1">
						<xs:annotation>
							<xs:documentation>Temporary limits on the aircraft that may use the runway access point, applying instead of its published usage limitation: maximum weight, maximum wingspan and pavement bearing strength. [PIXM]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="AbstractRunwayAccessPointStatus" type="pixm:AbstractRunwayAccessPointStatusType" abstract="true" substitutionGroup="pixm:AbstractPIXMNotification"/>
	<xs:complexType name="AbstractRunwayAccessPointStatusType" abstract="true">
		<xs:annotation>
			<xs:documentation>Abstract base feature for status notifications about a runway access point (a departure intersection or a landing exit). [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractPIXMNotificationType"/>
		</xs:complexContent>
	</xs:complexType>

	<!-- DepartureIntersectionStatus -->
	<xs:element name="DepartureIntersectionStatusTimeSlice" type="pixm:DepartureIntersectionStatusTimeSliceType" substitutionGroup="pixm:AbstractRunwayAccessPointStatusTimeSlice"/>
	<xs:complexType name="DepartureIntersectionStatusTimeSliceType">
		<xs:annotation>
			<xs:documentation>A time slice of a notification giving the operational status of a departure intersection. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractRunwayAccessPointStatusTimeSliceType"/>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="DepartureIntersectionStatus" type="pixm:DepartureIntersectionStatusType" substitutionGroup="pixm:AbstractRunwayAccessPointStatus"/>
	<xs:complexType name="DepartureIntersectionStatusType">
		<xs:annotation>
			<xs:documentation>A notification giving the operational status of a departure intersection: closed, active and any temporary restriction. Planned changes are given as TEMPDELTA time slices. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractRunwayAccessPointStatusType">
				<xs:sequence>
					<xs:element name="timeSlice" type="pixm:DepartureIntersectionStatusTimeSlicePropertyType" minOccurs="1" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>A time slice of the Departure Intersection Status feature: its state during one period of validity. [AIXM 5.1.1]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:complexType name="DepartureIntersectionStatusTimeSlicePropertyType">
		<xs:annotation>
			<xs:documentation>A property that contains one Departure Intersection Status time slice. [AIXM 5.1.1]</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="pixm:DepartureIntersectionStatusTimeSlice" minOccurs="1" maxOccurs="1"/>
		</xs:sequence>
		<xs:attributeGroup ref="gml:OwnershipAttributeGroup"/>
	</xs:complexType>

	<!-- LandingExitStatus -->
	<xs:element name="LandingExitStatusTimeSlice" type="pixm:LandingExitStatusTimeSliceType" substitutionGroup="pixm:AbstractRunwayAccessPointStatusTimeSlice"/>
	<xs:complexType name="LandingExitStatusTimeSliceType">
		<xs:annotation>
			<xs:documentation>A time slice of a notification giving the operational status of a landing exit. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractRunwayAccessPointStatusTimeSliceType"/>
		</xs:complexContent>
	</xs:complexType>

	<xs:element name="LandingExitStatus" type="pixm:LandingExitStatusType" substitutionGroup="pixm:AbstractRunwayAccessPointStatus"/>
	<xs:complexType name="LandingExitStatusType">
		<xs:annotation>
			<xs:documentation>A notification giving the operational status of a landing exit: closed, active and any temporary restriction. Planned changes are given as TEMPDELTA time slices. [PIXM]</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="pixm:AbstractRunwayAccessPointStatusType">
				<xs:sequence>
					<xs:element name="timeSlice" type="pixm:LandingExitStatusTimeSlicePropertyType" minOccurs="1" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>A time slice of the Landing Exit Status feature: its state during one period of validity. [AIXM 5.1.1]</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
